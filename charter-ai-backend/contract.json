  "_meta": {
    "name": "Charter AI recommendation contract",
    "version": "0.1-prototype",
    "purpose": "Single request/response shape between the React dashboard and the Python backend. Field names mirror src/data/mockData.js, so the UI needs no layout changes.",
    "sampleValues": "Sample values are copied from the primary mock preset (aus-paradip-coking-coal). Strings marked 'string' are generated by the backend.",
    "frontendChanges": "Only the source of the route object changes (mock import -> fetch). Keep mockData.js as a fallback when the request fails."
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/v1/charter/recommend",
      "request": "request",
      "response": "response"
    },
    {
      "method": "GET",
      "path": "/api/v1/ports",
      "returns": "ports.json content (for dropdowns and the Leaflet map)"
    },
    {
      "method": "GET",
      "path": "/api/v1/vessels",
      "returns": "vessels.json content"
    },
    {
      "method": "GET",
      "path": "/health",
      "returns": {
        "status": "ok"
      }
    }
  ],
